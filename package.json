{
  "name": "soundwavian-field",
  "productName": "Soundwavian Field",
  "version": "0.1.0",
  "private": true,
  "description": "Soundwavian Field // Galactic Mandala - a meditative generative WebGL screensaver",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/audit-offline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit-offline.mjs --native",
    "app:dev": "tauri dev",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "release": "node scripts/release.mjs",
    "release:signed": "node scripts/release.mjs --signed",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
